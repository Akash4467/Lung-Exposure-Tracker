# Copy to .env.local (git-ignored). EXPO_PUBLIC_ values are baked into the app and are
# visible to anyone with the APK: never put secrets here.
#   web / iOS simulator : http://localhost:18000
#   Android emulator    : http://10.0.2.2:18000
#   phone on your Wi-Fi : http://<your PC's LAN IP>:18000
#   production          : https://<you>.duckdns.org
EXPO_PUBLIC_API_URL=http://localhost:18000
