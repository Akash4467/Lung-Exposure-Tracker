# Copy to .env for local development. Never commit .env.
# In AWS these come from SSM Parameter Store.
ENV=local
LOG_LEVEL=info

DATABASE_URL=postgresql+asyncpg://lung:lung@localhost:55432/lung
VALKEY_URL=redis://localhost:6379/0

AWS_REGION=ap-south-1
# ElasticMQ locally; leave unset in AWS.
SQS_ENDPOINT_URL=http://localhost:9324
SQS_INGEST_URL=http://localhost:9324/000000000000/ingest-jobs
SQS_USER_URL=http://localhost:9324/000000000000/user-jobs
# ElasticMQ ignores credentials but boto needs some.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

OPEN_METEO_AIR_BASE=https://air-quality-api.open-meteo.com/v1
OPEN_METEO_WEATHER_BASE=https://api.open-meteo.com/v1

# Optional. Without it, commute routes fall back to a straight line.
ORS_API_KEY=

# Optional. NASA FIRMS fire detections for the smoke-risk flag (free key:
# https://firms.modaps.eosdis.nasa.gov/api/map_key/). Without it the flag stays "none".
FIRMS_MAP_KEY=

# Optional. Official ground monitors that correct the model near them.
# OpenAQ (worldwide): explore.openaq.org → account → API key.
OPENAQ_API_KEY=
# CPCB real-time data for India: data.gov.in → sign up → "My Account" → API key.
CPCB_API_KEY=

# ---- auth
# Production: a random 32+ character secret (e.g. `openssl rand -base64 48`), from SSM.
JWT_SECRET=
# Google sign-in: OAuth client IDs (Android, iOS, web), comma-separated
GOOGLE_CLIENT_IDS=

# ---- email (Brevo). Empty locally: emails, including codes, are printed in the API log.
BREVO_API_KEY=
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Lung Exposure Tracker

# ---- push (Firebase Cloud Messaging). Empty: pushes are logged instead.
FCM_PROJECT_ID=
# The service-account key file's JSON, on one line
FCM_SERVICE_ACCOUNT_JSON=
